# Copy to .env for local development: cp .env.example .env
# Production reads real process environment variables and never needs a .env file.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# The origin players' phones use. QR codes and join links are built from this value.
# For real phones on the same Wi-Fi, use your laptop's LAN address, e.g. http://192.168.1.20:5173
PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed for HTTP and Socket.IO. PUBLIC_ORIGIN is always allowed.
# With NODE_ENV=development, local-network addresses (localhost, 10.x, 172.16-31.x, 192.168.x,
# *.local) are also accepted so phones on the same Wi-Fi work before you edit this file.
# Production accepts only what is listed here.
ALLOWED_ORIGINS=http://localhost:5173

MAX_ROOMS=100
MAX_SOCKETS=900
ROOM_MAX_AGE_MS=21600000
ROOM_IDLE_MS=1800000
ROOM_ABANDONED_MS=600000

LOG_LEVEL=info

# Enables the /dev scenario gallery in the Vite dev server only. Must stay false in production.
ENABLE_DEVTOOLS=false

# Reverse-proxy trust for client IPs used in rate limiting. false (default), a hop count such as 1,
# or an exact proxy address/subnet. Never trust arbitrary X-Forwarded-For headers.
TRUST_PROXY=false

# Multiplies every rate-limit budget. Leave at 1 unless you are load-testing locally.
RATE_LIMIT_MULTIPLIER=1

# Test-only: scales every timed phase. Allowed only with NODE_ENV=test and a loopback HOST.
# GAME_TIME_SCALE=1
